rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function owner(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    function newOwner(field) { return signedIn() && request.resource.data[field] == request.auth.uid; }

    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if me(uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if newOwner('authorId');
      allow update, delete: if owner('authorId');
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if newOwner('authorId');
      allow update, delete: if owner('authorId');
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if newOwner('userId');
      allow delete: if owner('userId');
      allow update: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if newOwner('followerId') && request.resource.data.followingId != request.auth.uid;
      allow delete: if owner('followerId');
      allow update: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if owner('userId');
      allow create: if newOwner('userId');
      allow delete: if owner('userId');
      allow update: if false;
    }

    match /blocks/{blockId} {
      allow read: if owner('userId');
      allow create: if newOwner('userId') && request.resource.data.targetId != request.auth.uid;
      allow delete: if owner('userId');
      allow update: if false;
    }

    match /mutes/{muteId} {
      allow read: if owner('userId');
      allow create: if newOwner('userId') && request.resource.data.targetId != request.auth.uid;
      allow delete: if owner('userId');
      allow update: if false;
    }

    match /hiddenPosts/{hiddenId} {
      allow read: if owner('userId');
      allow create: if newOwner('userId');
      allow delete: if owner('userId');
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if owner('recipientId');
      allow create: if newOwner('actorId');
    }

    match /reports/{reportId} {
      allow create: if newOwner('reporterId');
      allow read: if owner('reporterId');
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /playlists/{playlistId} {
      allow read, update, delete: if owner('userId');
      allow create: if newOwner('userId');
      match /items/{itemId} {
        allow read, create, update, delete: if signedIn() && get(/databases/$(database)/documents/playlists/$(playlistId)).data.userId == request.auth.uid;
      }
    }

    match /drafts/{draftId} {
      allow read: if owner('userId');
      allow create: if newOwner('userId');
      allow update, delete: if owner('userId');
    }

    match /reports/{reportId} {
      allow create: if newOwner('reporterId');
      allow read: if owner('reporterId');
      allow update, delete: if false;
    }

    match /stats/{statId} { allow read: if true; allow write: if false; }
    match /appConfig/{configId} { allow read: if true; allow write: if false; }
  }
}
